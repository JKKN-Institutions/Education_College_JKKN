# ─────────────────────────────────────────────────────────────────────────────
# Supabase (shared across all college sites — same project)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─────────────────────────────────────────────────────────────────────────────
# College identity  (change these per-site deployment)
# ─────────────────────────────────────────────────────────────────────────────

# Unique identifier — must match the `id` column in the `colleges` table
# Options: education | ahs | arts | dental | nursing | pharmacy
NEXT_PUBLIC_COLLEGE_ID=education

# Full institution name (used in metadata, header, footer, login page)
NEXT_PUBLIC_COLLEGE_NAME=JKKN College of Education

# Short name (used in admin sidebar, compact UI)
NEXT_PUBLIC_COLLEGE_SHORT_NAME=Education College

# Tagline shown on the hero / homepage
NEXT_PUBLIC_COLLEGE_TAGLINE=Shaping the future of education

# ─────────────────────────────────────────────────────────────────────────────
# Branding / colors  (hex values, no quotes needed)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIMARY_COLOR=#006837
NEXT_PUBLIC_PRIMARY_DARK=#002309
NEXT_PUBLIC_PRIMARY_MID=#004d28
NEXT_PUBLIC_PRIMARY_HOVER=#005a2e

# ─────────────────────────────────────────────────────────────────────────────
# Contact details
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_COLLEGE_PHONE=+919345855001
NEXT_PUBLIC_COLLEGE_EMAIL=education@jkkn.ac.in
NEXT_PUBLIC_COLLEGE_ADDRESS=JKKN College of Education, NH-544 (Salem to Coimbatore Highway), Kumarapalayam, Namakkal (DT), Tamil Nadu. 638183.

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps embed URL (from Google Maps > Share > Embed a map)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...

# ─────────────────────────────────────────────────────────────────────────────
# Admission form URL (can differ per college)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMISSION_FORM_URL=https://admission.jkkn.ac.in/form/your-form-slug

# ─────────────────────────────────────────────────────────────────────────────
# Site domain (used for canonical URLs)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_DOMAIN=education.jkkn.ac.in

# ─────────────────────────────────────────────────────────────────────────────
# Logo path (relative to /public directory)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LOGO_PATH=/images/logo.png
